// Green Flagged iOS — local secrets template.
// Copy to Secrets.xcconfig (gitignored) and fill in.
// The `$()` escapes the // so xcconfig doesn't treat it as a comment.

SUPABASE_URL = https:/$()/pwvtjuklkfelpxzxjmsi.supabase.co
SUPABASE_ANON_KEY = sb_publishable_replace_me

// OpenAI — iOS calls the OpenAI API directly for scan/improve/tweak/fix/translate.
// Get a key at https://platform.openai.com/api-keys. Scope it tightly; this
// key ships in the app binary. Rotate if leaked.
OPENAI_API_KEY = sk_replace_me

// OpenAI model defaults. Override per build if needed.
OPENAI_REVIEW_MODEL = gpt-5-mini
OPENAI_DRAFT_MODEL = gpt-4o

// landing/ fallback — only still used for draft template rendering and PDF/DOCX
// export until those are ported on-device. Point at prod so the app works on a
// fresh Mac without `pnpm dev`.
API_BASE_URL = https:/$()/greenflagged.xyz
API_BASE_URL_DEBUG = https:/$()/greenflagged.xyz

// Bundle identifier — must match App Store Connect entry
PRODUCT_BUNDLE_IDENTIFIER = xyz.flag.green

// RevenueCat — public Apple API key (starts with `appl_`). Web webhook
// secret lives in landing/.env as REVENUECAT_WEBHOOK_SECRET; this side only
// needs the client key.
REVENUECAT_IOS_API_KEY = appl_replace_me
