# Email delivery — Resend
RESEND_API_KEY=re_your_resend_api_key
# Where leads & contact form submissions are forwarded
LEAD_TO_EMAIL=hello@greenflagged.app
# Verified sender ("Green Flagged <hello@greenflagged.app>")
MAIL_FROM="Green Flagged <hello@greenflagged.app>"

# Analytics (Plausible) — optional, public
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=greenflagged.app

# Supabase (project ref: pwvtjuklkfelpxzxjmsi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (used in Phase 2/3). Pick one — AI_PROVIDER controls routing.
AI_PROVIDER=openai           # openai | anthropic
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-6

# Default model for /scan and /improve when the client doesn't pick one.
# Must match an id in lib/ai/models.ts (e.g. gpt-5-mini, gpt-5, claude-sonnet-4-6).
AI_DEFAULT_MODEL=gpt-5-mini

# Revolut Merchant API (Phase 4 — payments)
# Sandbox base: https://sandbox-merchant.revolut.com
# Production base: https://merchant.revolut.com
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com
REVOLUT_API_KEY=
REVOLUT_WEBHOOK_SECRET=

# Daily renewal cron — Vercel sends this as `Authorization: Bearer ${CRON_SECRET}`
CRON_SECRET=
